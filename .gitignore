# Dependencias - generadas con npm install, no van al repo
node_modules/

# Archivos compilados
dist/

# Variables de entorno - contienen credenciales reales
.env*
!.env.example

# Llaves privadas y certificados
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Archivos de credenciales / secrets
secrets/
*credentials*.json
*service-account*.json

# Prisma - cliente generado automaticamente, se regenera con "npx prisma generate"
backend/src/generated/

# Claude Code - configuracion local (settings.local.json sigue ignorado)
.claude/*
!.claude/agents/

# Contexto para Claude Code - versionado para el equipo
CLAUDE.md
!CLAUDE.md
!backend/CLAUDE.md
!frontend/CLAUDE.md

# Logs
*.log
npm-debug.log*

# Sistema operativo
.DS_Store
Thumbs.db
