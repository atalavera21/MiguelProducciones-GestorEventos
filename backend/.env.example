# Puerto donde corre el servidor Express
PORT=3001

# URL de conexión a PostgreSQL.
# Desarrollo: instancia nativa local en la PC del desarrollador.
# Producción: se cambia esta variable según el proveedor — el código no se acopla a ninguno.
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/gestor_eventos"

# Secreto para firmar los JWT (auth)
# Debe ser una cadena larga y aleatoria — nunca compartir en producción
JWT_SECRET="cambia_esto_por_un_secreto_seguro"

# Duración del token JWT (ej: 8h, 1d, 7d)
JWT_EXPIRES_IN=8h

# Contraseñas iniciales de usuarios — usadas únicamente por prisma/seed.ts
# No deben estar vacías al correr el seed
SEED_ADMIN_PASSWORD=
SEED_DUENO_PASSWORD=
SEED_DEMO_PASSWORD=

# Entorno de ejecución
NODE_ENV="development"
